# ───────────────────────────────────────────────
# 데모 모드 (true = API 키 없이 즉시 실행 가능)
# ───────────────────────────────────────────────
DEMO_MODE=true

# ───────────────────────────────────────────────
# 토스증권 Open API (KOSPI) — 메인 브로커
# 발급: https://corp.tossinvest.com/ko/open-api
# ───────────────────────────────────────────────
TOSS_APP_KEY=your_client_id_here
TOSS_APP_SECRET=your_client_secret_here
TOSS_ACCOUNT_NO=your_toss_account_number
TOSS_MOCK=true

# 한국투자증권 KIS API (KOSPI) — 대체 브로커 (선택)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number
KIS_MOCK=true

# Alpaca API (NASDAQ) — DEMO_MODE=false 시 필요
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# LLM (Claude) — 없으면 데모 판단 자동 사용
ANTHROPIC_API_KEY=

# Telegram 알림 (선택, 없으면 조용히 스킵)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 앱 설정
LOG_LEVEL=INFO
DB_PATH=data/trading.db

# 서버
HOST=0.0.0.0
PORT=8000
